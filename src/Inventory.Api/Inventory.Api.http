@Inventory.Api_HostAddress = http://localhost:5295

### Get all categories
GET {{Inventory.Api_HostAddress}}/api/categories
Accept: application/json

### Get category by ID
GET {{Inventory.Api_HostAddress}}/api/categories/1
Accept: application/json

### Create a category
POST {{Inventory.Api_HostAddress}}/api/categories
Content-Type: application/json

{
  "name": "Office Supplies"
}

### Update a category
PUT {{Inventory.Api_HostAddress}}/api/categories/1
Content-Type: application/json

{
  "id": 1,
  "name": "Office Supplies"
}

### Delete a category
DELETE {{Inventory.Api_HostAddress}}/api/categories/1

### Get all products
GET {{Inventory.Api_HostAddress}}/api/products
Accept: application/json

### Get product by ID
GET {{Inventory.Api_HostAddress}}/api/products/1
Accept: application/json

### Create a product
POST {{Inventory.Api_HostAddress}}/api/products
Content-Type: application/json

{
  "name": "Wireless Mouse",
  "categoryId": 1,
  "stock": 25
}

### Update a product
PUT {{Inventory.Api_HostAddress}}/api/products/1
Content-Type: application/json

{
  "id": 1,
  "name": "Wireless Mouse",
  "categoryId": 1,
  "stock": 30
}

### Delete a product
DELETE {{Inventory.Api_HostAddress}}/api/products/1

### Get inventory movements by product ID
GET {{Inventory.Api_HostAddress}}/api/inventory-movements/product/1
Accept: application/json

### Create an inventory movement
POST {{Inventory.Api_HostAddress}}/api/inventory-movements
Content-Type: application/json

{
  "productId": 1,
  "quantity": 5,
  "movementType": 1
}
